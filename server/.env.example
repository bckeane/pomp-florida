# Local defaults
PORT=48310
CORS_ALLOWED_ORIGINS=http://localhost:48311
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Break-glass admin account (optional). Password is a salted hash, not
# plaintext — generate one (run from server/):
#   node -e "import('./src/lib/passwords.js').then(({hashPassword}) => console.log(hashPassword('your-new-password')))"
BREAK_GLASS_EMAIL=
BREAK_GLASS_PASSWORD_HASH=

# Password reset emails (optional). Without these, /auth/forgot-password
# still works but logs the reset link to the server console instead of
# emailing it — fine for local dev, not for production.
RESEND_API_KEY=
EMAIL_FROM=
# Base URL of the client app used to build the reset link. Falls back to the
# first CORS_ALLOWED_ORIGINS entry if unset.
APP_BASE_URL=
